{
  "name": "ripple-design-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "api:generate": "uv run --project ../backend --frozen python ../backend/scripts/export_openapi.py --openapi-output src/api/generated/openapi.json --types-output src/api/generated/openapi.ts",
    "api:check": "uv run --project ../backend --frozen python ../backend/scripts/export_openapi.py --check --openapi-output src/api/generated/openapi.json --types-output src/api/generated/openapi.ts",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run api:check && tsc -b && vite build",
    "build:preview": "tsc -b && vite build",
    "lint": "eslint --ignore-pattern dist --ignore-pattern node_modules .",
    "test": "vitest --exclude e2e/**",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-table": "9.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "msw": "3.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "7.90.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "vite": "^7.1.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tanstack/router-plugin": "1.168.45",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "jsdom": "30.1.2",
    "typescript": "~5.9.3",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "browser": true,
      "es2022": true,
      "node": true
    },
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "plugins": [
      "@typescript-eslint",
      "react-hooks",
      "react-refresh"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:react-hooks/recommended"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_"
        }
      ],
      "@typescript-eslint/no-unused-expressions": "off",
      "react-refresh/only-export-components": "warn"
    }
  }
}
