RIPPLE_ENVIRONMENT=preview
RIPPLE_MODEL_PROVIDER=synthetic
RIPPLE_INTAKE_MODEL=gemini-3.8-flash
# Optional preview opt-in; keep the real key in the deployment secret store only.
# RIPPLE_MODEL_PROVIDER=gemini_developer
# RIPPLE_GEMINI_API_KEY=replace-with-preview-secret
# Copy the session-pooler URL from Supabase. Both postgres:// and postgresql:// are accepted.
RIPPLE_DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
RIPPLE_CORS_ORIGINS=["https://YOUR_VERCEL_PROJECT.vercel.app"]
# Optional for branch preview URLs. Keep the stable URL in CORS_ORIGINS too.
RIPPLE_CORS_ORIGIN_REGEX=^https://ripple-[a-z0-9-]+\.vercel\.app$
RIPPLE_DB_POOL_SIZE=2
RIPPLE_DB_MAX_OVERFLOW=1
RIPPLE_DEMO_SCENARIO_ID=A-12-base
