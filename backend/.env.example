RIPPLE_ENVIRONMENT=local
RIPPLE_MODEL_PROVIDER=synthetic
RIPPLE_INTAKE_MODEL=gemini-3.8-flash
# Optional local/preview opt-in. Use a real key only in the ignored local .env.
# RIPPLE_MODEL_PROVIDER=gemini_developer
# RIPPLE_GEMINI_API_KEY=replace-with-local-placeholder
RIPPLE_DATABASE_URL=postgresql+asyncpg://ripple:ripple@127.0.0.1:5432/ripple
RIPPLE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RIPPLE_DB_POOL_SIZE=5
RIPPLE_DB_MAX_OVERFLOW=3
RIPPLE_DEMO_SCENARIO_ID=A-12-base
